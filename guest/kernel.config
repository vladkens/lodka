# lodka's guest kernel: `make allnoconfig` with these options, everything built in, no modules.
# scripts/build-guest.sh fails when an option is not applied (a dependency is missing).

# Platform: lodka's own VMM on Hypervisor.framework (GICv3, PL011 console, PL031 clock)
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_GIC=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_AMBA=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_HCTOSYS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_JUMP_LABEL=y
CONFIG_PRINTK=y
CONFIG_KALLSYMS=y

# Devices
CONFIG_TTY=y
