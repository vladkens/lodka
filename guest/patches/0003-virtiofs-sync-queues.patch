+/*
+ * Whether a request is worth a sync queue: one a task waits for, short. A sync, a lock wait or
+ * big I/O would hold the vCPU for long.
+ */
+static bool virtio_fs_sync_op(struct fuse_req *req)
+{
+	struct fuse_args *args = req->args;
+
+	if (test_bit(FR_BACKGROUND, &req->flags) || !test_bit(FR_ISREPLY, &req->flags))
+		return false;
+
+	switch (req->in.h.opcode) {
+	case FUSE_FSYNC:
+	case FUSE_FSYNCDIR:
+	case FUSE_SYNCFS:
+	case FUSE_FALLOCATE:
+	case FUSE_COPY_FILE_RANGE:
+	case FUSE_COPY_FILE_RANGE_64:
+	case FUSE_SETLKW:
+		return false;
+	}
+
+	return req->in.h.len + fuse_len_args(args->out_numargs, args->out_args) <= SZ_128K;
+}
+
+/*
+ * Sends a request on this CPU's sync queue and has the host serve it in a hypercall, then ends
+ * it here: no interrupt, no worker, no wakeup. False to send it on a request queue instead.
+ */
+static bool virtio_fs_send_sync(struct virtio_fs *fs, struct fuse_req *req)
+{
+	struct virtio_fs_vq *fsvq;
+	struct arm_smccc_res res;
+	struct fuse_pqueue *fpq;
+	struct fuse_req *done;
+	unsigned int cpu, qid, len;
+
+	if (!virtio_fs_sync_op(req))
+		return false;
+
+	/* The queue is this CPU's until the request is back */
+	cpu = get_cpu();
+	if (cpu >= fs->num_sync_queues) {
+		put_cpu();
+		return false;
+	}
+
+	qid = fs->sync_vq + cpu;
+	fsvq = &fs->vqs[qid];
+	if (virtio_fs_enqueue_req(fsvq, req, false, GFP_ATOMIC) < 0) {
+		put_cpu();
+		return false;
+	}
+
+	arm_smccc_1_1_hvc(VIRTIO_FS_HVC_SYNC, fs->mmio_base, qid, &res);
+	spin_lock(&fsvq->lock);
+	done = virtqueue_get_buf(fsvq->vq, &len);
+	spin_unlock(&fsvq->lock);
+	put_cpu();
+
+	fpq = &fsvq->fud->pq;
+	if (done == req && len == sizeof(req->out.h) &&
+	    req->out.h.error == -VIRTIO_FS_SYNC_AGAIN) {
+		/* It would hold the vCPU: undo the sending, for a request queue */
+		spin_lock(&fpq->lock);
+		list_del_init(&req->list);
+		spin_unlock(&fpq->lock);
+		kfree(req->argbuf);
+		req->argbuf = NULL;
+		clear_bit(FR_SENT, &req->flags);
+		spin_lock(&fsvq->lock);
+		dec_in_flight_req(fsvq);
+		spin_unlock(&fsvq->lock);
+		return false;
+	}
+
+	if (done != req) {
+		/* The host didn't serve it: no more sync queues, and the request fails */
+		pr_err_once("virtio-fs: sync queue %u not served (%ld)\n", qid, (long)res.a0);
+		fs->sync_vq = 0;
+		len = 0;
+	}
+
+	if (!virtio_fs_verify_response(req, len)) {
+		req->out.h.error = -EIO;
+		req->out.h.len = sizeof(struct fuse_out_header);
+	}
+
+	spin_lock(&fpq->lock);
+	list_del_init(&req->list);
+	spin_unlock(&fpq->lock);
+	virtio_fs_request_complete(req, fsvq);
+	return true;
+}
+
