+/* Gives a notification buffer back to the device; called with fsvq->lock held */
+static void virtio_fs_notify_post(struct virtio_fs_vq *fsvq, void *buf,
+				  unsigned int size)
+{
+	struct scatterlist sg;
+
+	sg_init_one(&sg, buf, size);
+	if (virtqueue_add_inbuf(fsvq->vq, &sg, 1, buf, GFP_ATOMIC))
+		pr_warn_once("virtio-fs: no room for a notification buffer\n");
+}
+
+/*
+ * A file changed on the host: drop what the guest cached of it, and tell inotify. Contents
+ * (off >= 0) are a modification and a close after writing, attributes alone a change of them.
+ */
+static void virtio_fs_inval_inode(struct fuse_conn *fc,
+				  struct fuse_notify_inval_inode_out *o)
+{
+	__u32 mask = o->off < 0 ? FS_ATTRIB : FS_MODIFY;
+	struct dentry *dentry;
+	struct inode *inode;
+
+	/*
+	 * Counted as an evict, before the inode is looked for: one a LOOKUP or READDIRPLUS reply on
+	 * its way makes, from attributes older than the change, takes them as stale.
+	 */
+	atomic64_inc_return(&fc->evict_ctr);
+	if (fuse_reverse_inval_inode(fc, o->ino, o->off, o->len))
+		return;
+
+	inode = fuse_ilookup(fc, o->ino, NULL);
+	if (!inode)
+		return;
+
+	dentry = d_find_any_alias(inode);
+	if (dentry) {
+		fsnotify_dentry(dentry, mask);
+		if (mask == FS_MODIFY)
+			fsnotify_dentry(dentry, FS_CLOSE_WRITE);
+		dput(dentry);
+	} else {
+		fsnotify_inode(inode, mask);
+	}
+	iput(inode);
+}
+
+/*
+ * A file the guest never looked up was written on the host. inotify reports a change to a
+ * file in a watched directory only through the file's own dentry, so look it up if inotify
+ * watches the directory; else there is nothing to do.
+ */
+static void virtio_fs_modified(struct fuse_conn *fc, u64 parent, struct qstr *name)
+{
+	struct dentry *dir, *child;
+	struct inode *inode;
+
+	inode = fuse_ilookup(fc, parent, NULL);
+	if (!inode)
+		return;
+	dir = fsnotify_inode_watches_children(inode) ? d_find_any_alias(inode) : NULL;
+	iput(inode);
+	if (!dir)
+		return;
+
+	child = lookup_noperm_unlocked(name, dir);
+	if (!IS_ERR(child)) {
+		if (d_really_is_positive(child)) {
+			fsnotify_dentry(child, FS_MODIFY);
+			fsnotify_dentry(child, FS_CLOSE_WRITE);
+		}
+		dput(child);
+	}
+	dput(dir);
+}
+
+/*
+ * A name in a directory changed on the host: drop it and the directory's listing from the
+ * guest's caches, and tell inotify it was made (INVAL_ENTRY) or removed (DELETE).
+ */
+static void virtio_fs_inval_entry(struct fuse_conn *fc, int code, void *arg,
+				  unsigned int size)
+{
+	__u32 mask = FS_CREATE, namelen, flags;
+	struct inode *dir;
+	u64 parent, child = 0;
+	unsigned int hdr;
+	struct qstr name;
+	char *s;
+
+	if (code == FUSE_NOTIFY_DELETE) {
+		struct fuse_notify_delete_out *o = arg;
+
+		hdr = sizeof(*o);
+		if (size < hdr)
+			return;
+		parent = o->parent;
+		child = o->child;
+		namelen = o->namelen;
+		flags = o->padding;
+		mask = FS_DELETE;
+	} else {
+		struct fuse_notify_inval_entry_out *o = arg;
+
+		hdr = sizeof(*o);
+		if (size < hdr)
+			return;
+		parent = o->parent;
+		namelen = o->namelen;
+		flags = o->flags;
+	}
+
+	s = arg + hdr;
+	if (namelen > fc->name_max || size != hdr + namelen + 1 || s[namelen])
+		return;
+	name = (struct qstr)QSTR_INIT(s, namelen);
+
+	if (flags & VIRTIO_FS_INVAL_MODIFIED) {
+		virtio_fs_modified(fc, parent, &name);
+		return;
+	}
+
+	if (flags & VIRTIO_FS_INVAL_DIR)
+		mask |= FS_ISDIR;
+
+	fuse_reverse_inval_entry(fc, parent, child, &name, flags & FUSE_EXPIRE_ONLY);
+	dir = fuse_ilookup(fc, parent, NULL);
+	if (!dir)
+		return;
+
+	/* The listing changed, whether or not the guest has the name cached */
+	fuse_invalidate_attr(dir);
+	inode_maybe_inc_iversion(dir, false);
+	fsnotify_name(mask, dir, FSNOTIFY_EVENT_INODE, dir, &name, 0);
+	iput(dir);
+}
+
+/*
+ * The host lost track of what changed (INC_EPOCH): every cached name is looked up again, and
+ * every inode's attributes, pages and listing are dropped, as for an INVAL_INODE each. Open
+ * files and mappings look up no name, so the epoch alone leaves them stale.
+ */
+static void virtio_fs_inval_all(struct fuse_conn *fc)
+{
+	struct inode *inode, *put = NULL;
+	struct fuse_mount *fm;
+
+	atomic_inc(&fc->epoch);
+	/* For the inodes replies on their way make, which the walk misses: as in inval_inode */
+	atomic64_inc_return(&fc->evict_ctr);
+	list_for_each_entry(fm, &fc->mounts, fc_entry) {
+		struct super_block *sb = fm->sb;
+
+		if (!sb)
+			continue;
+
+		/* As drop_pagecache_sb: the inode kept is the walk's place in the list */
+		spin_lock(&sb->s_inode_list_lock);
+		list_for_each_entry(inode, &sb->s_inodes, i_sb_list) {
+			struct fuse_inode *fi = get_fuse_inode(inode);
+
+			spin_lock(&inode->i_lock);
+			if (inode->i_state & (I_FREEING | I_WILL_FREE | I_NEW)) {
+				spin_unlock(&inode->i_lock);
+				continue;
+			}
+			__iget(inode);
+			spin_unlock(&inode->i_lock);
+			spin_unlock(&sb->s_inode_list_lock);
+
+			spin_lock(&fi->lock);
+			fi->attr_version = atomic64_inc_return(&fc->attr_version);
+			spin_unlock(&fi->lock);
+			fuse_invalidate_attr(inode);
+			forget_all_cached_acls(inode);
+			if (S_ISREG(inode->i_mode))
+				invalidate_inode_pages2(inode->i_mapping);
+			else if (S_ISDIR(inode->i_mode))
+				inode_maybe_inc_iversion(inode, false);
+
+			iput(put);
+			put = inode;
+			cond_resched();
+			spin_lock(&sb->s_inode_list_lock);
+		}
+		spin_unlock(&sb->s_inode_list_lock);
+	}
+	iput(put);
+}
+
+static void virtio_fs_notify(struct fuse_conn *fc, void *buf, unsigned int len)
+{
+	struct fuse_out_header *oh = buf;
+
+	if (len < sizeof(*oh) || oh->len != len || oh->unique) {
+		pr_warn_ratelimited("virtio-fs: bad notification (%u bytes)\n", len);
+		return;
+	}
+
+	len -= sizeof(*oh);
+	down_read(&fc->killsb);
+	switch (oh->error) {
+	case FUSE_NOTIFY_INVAL_INODE:
+		if (len == sizeof(struct fuse_notify_inval_inode_out))
+			virtio_fs_inval_inode(fc, (void *)(oh + 1));
+		break;
+	case FUSE_NOTIFY_INVAL_ENTRY:
+	case FUSE_NOTIFY_DELETE:
+		virtio_fs_inval_entry(fc, oh->error, oh + 1, len);
+		break;
+	case FUSE_NOTIFY_INC_EPOCH:
+		virtio_fs_inval_all(fc);
+		break;
+	}
+	up_read(&fc->killsb);
+}
+
+/* Work function for the notification queue: handle each, give its buffer back */
+static void virtio_fs_notify_done_work(struct work_struct *work)
+{
+	struct virtio_fs_vq *fsvq = container_of(work, struct virtio_fs_vq,
+						 done_work);
+	struct virtqueue *vq = fsvq->vq;
+	struct virtio_fs *fs = vq->vdev->priv;
+	struct fuse_conn *fc;
+	unsigned int len;
+	void *buf;
+
+	spin_lock(&fsvq->lock);
+	do {
+		virtqueue_disable_cb(vq);
+
+		while ((buf = virtqueue_get_buf(vq, &len)) != NULL) {
+			fc = NULL;
+			if (fsvq->connected && fsvq->fud && fsvq->fud->fc)
+				fc = fuse_conn_get(fsvq->fud->fc);
+			spin_unlock(&fsvq->lock);
+
+			if (fc) {
+				virtio_fs_notify(fc, buf, min(len, fs->notify_buf_size));
+				fuse_conn_put(fc);
+			}
+
+			spin_lock(&fsvq->lock);
+			virtio_fs_notify_post(fsvq, buf, fs->notify_buf_size);
+		}
+	} while (!virtqueue_enable_cb(vq));
+	virtqueue_kick(vq);
+	spin_unlock(&fsvq->lock);
+}
+
+/* Fills the notification queue with buffers, once the device is ready */
+static int virtio_fs_notify_start(struct virtio_fs *fs)
+{
+	struct virtio_fs_vq *fsvq;
+	unsigned int i, n;
+
+	if (!fs->notify_vq)
+		return 0;
+
+	fsvq = &fs->vqs[fs->notify_vq];
+	n = virtqueue_get_vring_size(fsvq->vq);
+	fs->notify_bufs = kcalloc(n, fs->notify_buf_size, GFP_KERNEL);
+	if (!fs->notify_bufs)
+		return -ENOMEM;
+
+	spin_lock(&fsvq->lock);
+	for (i = 0; i < n; i++)
+		virtio_fs_notify_post(fsvq, fs->notify_bufs + i * fs->notify_buf_size,
+				      fs->notify_buf_size);
+	virtqueue_kick(fsvq->vq);
+	spin_unlock(&fsvq->lock);
+	return 0;
+}
