virtiofs: caller_owns, for a server that answers as one host user

lodka serves the Mac's files as the Mac user: macOS checks every access, and the uid and gid a
file has on the Mac mean nothing in the guest. With caller_owns the guest checks no permissions
of its own (no default_permissions) and shows each file as owned by whoever asks, so one
process's view isn't cached for another and tools that check the owner (git, ssh, npm) accept
the files, as with Virtualization.framework's shares.

diff --git a/fs/fuse/dir.c b/fs/fuse/dir.c
index 9e20bc9..55ef716 100644
--- a/fs/fuse/dir.c
+++ b/fs/fuse/dir.c
@@ -2190,6 +2190,7 @@ static int fuse_getattr(struct mnt_idmap *idmap,
 {
 	struct inode *inode = d_inode(path->dentry);
 	struct fuse_conn *fc = get_fuse_conn(inode);
+	int err;
 
 	if (fuse_is_bad(inode))
 		return -EIO;
@@ -2207,7 +2208,13 @@ static int fuse_getattr(struct mnt_idmap *idmap,
 		return -EACCES;
 	}
 
-	return fuse_update_get_attr(idmap, inode, NULL, stat, request_mask, flags);
+	err = fuse_update_get_attr(idmap, inode, NULL, stat, request_mask, flags);
+	if (!err && fc->caller_owns) {
+		stat->uid = current_fsuid();
+		stat->gid = current_fsgid();
+	}
+
+	return err;
 }
 
 static const struct inode_operations fuse_dir_inode_operations = {
